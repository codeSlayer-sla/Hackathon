# Copy to .env and adjust per node. docker-compose.yml already sets sane
# per-service defaults; this file documents every variable a node reads
# (services/*/app via qvac_mesh_shared.config.NodeSettings) so a peer can be
# moved to a second physical machine by only editing these values -- never
# by hardcoding an IP in code.

# Identity
NODE_ID=node-local
ROLE=enterprise            # enterprise | medium_provider | large_provider
MODEL_TIER=small           # small | medium | large
MODEL_KIND=completion      # completion | multimodal | transcription
MODEL_NAME=LLAMA_3_2_1B_INST_Q4_0
MODEL_PROJECTION_NAME=     # multimodal peers only, e.g. MMPROJ_VISIONPSY_NANO_460M_MULTIMODAL_Q8_0
PRICE_PER_1K_TOKENS=0
PORT=8000

# Peer discovery (no hardcoded IPs: point these at wherever each service
# actually runs -- another container, another host on the LAN, etc.)
ROUTER_URL=http://router:8000
RAG_URL=http://rag:8000
PEER_MEDIUM_URL=http://peer-medium:8000
PEER_LARGE_URL=http://peer-gpu:8000

# QVAC
QVAC_CACHE_DIR=/data/qvac-models

# Installed Base (Philips challenge)
INSTALLED_BASE_URL=http://installed-base:8000
INSTALLED_BASE_DB_PATH=/data/installed_base.db
INSTALLED_BASE_MEDIA_DIR=/data/media   # shared with peer-vision/peer-voice for photo/audio paths
AUTH_PEPPER=hackathon-demo-pepper-change-me   # PIN hashing pepper -- change before any real use

# Frontend (build-time)
VITE_ROUTER_URL=http://localhost:8001
VITE_INSTALLED_BASE_URL=http://localhost:8005
