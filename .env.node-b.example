# Copy to .env.node-b on Node B (the laptop running docker-compose.node-b.yml)
# and set this to Node A's real LAN IP (not localhost, not a Docker service
# name -- an actual address reachable from Node B, e.g. 192.168.1.23).
# See docs/multi-host-demo.md for how to find it.
ROUTER_HOST=192.168.1.23
